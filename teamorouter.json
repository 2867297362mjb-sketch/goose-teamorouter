    { "name": "gpt-5.5", "context_limit": 1000000 },
    { "name": "gemini-3.8-flash", "context_limit": 1000000 },
    { "name": "deepseek-v4-pro", "context_limit": 1000000 },
    { "name": "deepseek-v4-flash", "context_limit": 1000000 },
    { "name": "glm-5.3", "context_limit": 1000000 },
    { "name": "kimi-k3", "context_limit": 1000000 },
    { "name": "qwen3.8-max", "context_limit": 262144 }
